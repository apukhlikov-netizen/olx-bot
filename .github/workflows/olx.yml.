имя: olx-monitor

на:
  расписание:
    - cron: "*/15 * * * *"
  workflow_dispatch:

разрешения:
  содержимое: написать

вакансии:
  проверять:
    runs-on: ubuntu-latest
    шаги:
      - использует: actions/checkout@v4
      - использует: actions/setup-python@v5
        с:
          python-version: "3.12"
      - имя: Запуск бота
        выполнить: python olx_bot.py
        окружающая среда:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      - имя: Сохранить просмотренные объявления
        выполнить: |
          git config user.name "olx-bot"
          git config user.email "olx-bot@users.noreply.github.com"
          git add seen.json
          git diff --cached --quiet || (git commit -m "update seen" && git push)
